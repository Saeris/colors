{
  "name": "@saeris/colors",
  "version": "0.1.2",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saeris/colors.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "exports": {
    "./*.css": "./dist/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsx ./src/index.ts",
    "release": "yarn build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@saeris/eslint-config": "^3.1.2",
    "@types/node": "24.0.10",
    "colorjs.io": "^0.5.2",
    "eslint": "9.30.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "5.8.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none",
    "bracketSpacing": true,
    "jsxBracketSameLine": false
  }
}
